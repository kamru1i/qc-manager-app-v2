# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri keys
tauri-private.*

# scratch and temp files
/scratch
/graphify-out

# agent/AI tool configs
AGENTS.md
CLAUDE.md
.claude/
.mimocode/

# db migrations & backups
/migration_output*.sql
/supabase data/

# android keystore
android/*.jks
android/keystore-base64.txt
android/android-release-credentials.txt
# Temporary home for server-only routes during static export builds (scripts/build-tauri.js).
# Left behind if a build is interrupted — never commit it.
src/.route-backup/
src/api_backup/
__pycache__/

# pnpm resolves its own versions and does not read package-lock.json, so committing
# this alongside it would give CI and local builds two different dependency trees.
pnpm-lock.yaml

# logs and dumps
*.log
